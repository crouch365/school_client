 `⏎`","insert",{"range":"793","text":"794"},"import/order","`./guards` import should occur before import of `@/entities/user`","ImportDeclaration",{"range":"795","text":"796"},{"range":"797","text":"794"},"`./TestCard` import should occur before type import of `../../model/types`",{"range":"798","text":"799"},"Replace `⏎······<TestCard⏎········test={testDto}⏎········actions={<button·type=\"button\">Начать</button>}⏎······/>,⏎····` with `<TestCard·test={testDto}·actions={<button·type=\"button\">Начать</button>}·/>`",{"range":"800","text":"801"},{"range":"802","text":"794"},"`./LoginForm` import should occur before import of `@/mocks/token`",{"range":"803","text":"804"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/grantAccess/ui/GrantAccessModal.tsx:43:7\n  41 |     if (isOpen) {\n  42 |       reset({ className: '' });\n> 43 |       setFormError(null);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  44 |     }\n  45 |   }, [isOpen, reset]);\n  46 |","react-hooks/incompatible-library","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageTest/ui/QuestionFormModal.tsx:48:19\n  46 |   });\n  47 |\n> 48 |   const options = watch('options');\n     |                   ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  49 |   const correctOptionIndex = watch('correctOptionIndex');\n  50 |\n  51 |   useEffect(() => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageTest/ui/TestFormModal.tsx:55:7\n  53 |         timeLimitMinutes: test ? Math.round(test.timeLimit / 60) || 1 : 10,\n  54 |       });\n> 55 |       setFormError(null);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  56 |     }\n  57 |   }, [isOpen, test, reset]);\n  58 |","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageUsers/ui/UserFormModal.tsx:53:16\n  51 |   });\n  52 |\n> 53 |   const role = watch('role');\n     |                ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  54 |   const isStudent = role === 'STUDENT';\n  55 |\n  56 |   useEffect(() => {","`./QuestionStep` import should occur before type import of `@/entities/question`",{"range":"805","text":"806"},["807"],"`@/shared/config/env` import should occur after import of `../helpers`",{"range":"808","text":"809"},"`@/shared/lib` import should occur after import of `../helpers`",{"range":"810","text":"811"},{"range":"812","text":"813"},"`../token` import should occur after import of `../helpers`",{"range":"814","text":"815"},{"range":"816","text":"817"},{"range":"818","text":"819"},{"range":"820","text":"821"},{"range":"822","text":"823"},"@typescript-eslint/no-unused-vars","'password' is defined but never used.","Identifier","unusedVar","'_password' is assigned a value but never used.","`react` type import should occur after import of `@testing-library/react`",{"range":"824","text":"825"},[397,441],"ErrorBoundaryProps, ErrorBoundaryState",{"fix":"826","messageId":"827","data":"828","desc":"829"},[1141,1153],"",[1198,1313]," type=\"button\" className={styles.button} onClick={this.handleReload}",[1440,1440],"\n",[162,337],"import { RequireAuth, RequireRole } from './guards';\nimport { sessionActions, type SessionUser } from '@/entities/user';\nimport { createTestStore } from '@/test/test-utils';\n\n",[2912,2912],[58,147],"import { TestCard } from './TestCard';\nimport type { TestDto } from '../../model/types';\n",[1106,1216],"<TestCard test={testDto} actions={<button type=\"button\">Начать</button>} />",[1501,1501],[224,381],"import { LoginForm } from './LoginForm';\nimport { DEMO_PAYLOADS, signMockToken } from '@/mocks/token';\nimport { createTestStore } from '@/test/test-utils';\n\n",[111,219],"import { QuestionStep } from './QuestionStep';\nimport type { Saf