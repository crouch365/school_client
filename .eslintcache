"973"},{"ruleId":"799","severity":1,"message":"902","line":3,"column":1,"nodeType":"801","endLine":3,"endColumn":47,"fix":"974"},{"ruleId":"975","severity":1,"message":"976","line":8,"column":38,"nodeType":"977","messageId":"978","endLine":8,"endColumn":46},{"ruleId":"808","severity":1,"message":"979","line":85,"column":25,"nodeType":null,"messageId":"810","endLine":85,"endColumn":93,"fix":"980"},{"ruleId":"975","severity":1,"message":"981","line":90,"column":23,"nodeType":"977","messageId":"978","endLine":90,"endColumn":32},{"ruleId":"808","severity":1,"message":"904","line":115,"column":24,"nodeType":null,"messageId":"869","endLine":116,"endColumn":2,"fix":"982"},{"ruleId":"808","severity":1,"message":"983","line":118,"column":38,"nodeType":null,"messageId":"810","endLine":119,"endColumn":51,"fix":"984"},{"ruleId":"808","severity":1,"message":"985","line":27,"column":12,"nodeType":null,"messageId":"810","endLine":27,"endColumn":65,"fix":"986"},{"ruleId":"808","severity":1,"message":"987","line":35,"column":73,"nodeType":null,"messageId":"810","endLine":37,"endColumn":5,"fix":"988"},{"ruleId":"808","severity":1,"message":"856","line":44,"column":4,"nodeType":null,"messageId":"857","endLine":44,"endColumn":4,"fix":"989"},{"ruleId":"808","severity":1,"message":"990","line":15,"column":60,"nodeType":null,"messageId":"810","endLine":18,"endColumn":5,"fix":"991"},{"ruleId":"808","severity":1,"message":"856","line":40,"column":4,"nodeType":null,"messageId":"857","endLine":40,"endColumn":4,"fix":"992"},{"ruleId":"808","severity":1,"message":"993","line":42,"column":44,"nodeType":null,"messageId":"810","endLine":44,"endColumn":5,"fix":"994"},{"ruleId":"808","severity":1,"message":"856","line":53,"column":4,"nodeType":null,"messageId":"857","endLine":53,"endColumn":4,"fix":"995"},{"ruleId":"808","severity":1,"message":"856","line":2,"column":29,"nodeType":null,"messageId":"857","endLine":2,"endColumn":29,"fix":"996"},{"ruleId":"808","severity":1,"message":"856","line":10,"column":75,"nodeType":null,"messageId":"857","endLine":10,"endColumn":75,"fix":"997"},{"ruleId":"799","severity":1,"message":"998","line":1,"column":1,"nodeType":"801","endLine":1,"endColumn":54,"fix":"999"},{"ruleId":"808","severity":1,"message":"909","line":20,"column":42,"nodeType":null,"messageId":"869","endLine":21,"endColumn":6,"fix":"1000"},{"ruleId":"808","severity":1,"message":"856","line":55,"column":3,"nodeType":null,"messageId":"857","endLine":55,"endColumn":3,"fix":"1001"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/assignTeacher/ui/AssignTeacherModal.tsx:54:7\n  52 |       classForm.reset({ value: '' });\n  53 |       subjectForm.reset({ value: '' });\n> 54 |       setFormError(null);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  55 |     }\n  56 |   }, [isOpen, classForm, subjectForm]);\n  57 |","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/grantAccess/ui/GrantAccessModal.tsx:43:7\n  41 |     if (isOpen) {\n  42 |       reset({ className: '' });\n> 43 |       setFormError(null);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  44 |     }\n  45 |   }, [isOpen, reset]);\n  46 |","react-hooks/incompatible-library","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageTest/ui/QuestionFormModal.tsx:48:19\n  46 |   });\n  47 |\n> 48 |   const options = watch('options');\n     |                   ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  49 |   const correctOptionIndex = watch('correctOptionIndex');\n  50 |\n  51 |   useEffect(() => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageTest/ui/TestFormModal.tsx:55:7\n  53 |         timeLimitMinutes: test ? Math.round(test.timeLimit / 60) || 1 : 10,\n  54 |       });\n> 55 |       setFormError(null);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  56 |     }\n  57 |   }, [isOpen, test, reset]);\n  58 |","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/manageUsers/ui/UserFormModal.tsx:53:16\n  51 |   });\n  52 |\n> 53 |   const role = watch('role');\n     |                ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  54 |   const isStudent = role === 'STUDENT';\n  55 |\n  56 |   useEffect(() => {","react-hooks/purity","Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/michail01/Desktop/Практика/School_tests/client/src/features/takeTest/model/useCountdown.ts:16:38\n  14 | export const useCountdown = (totalSeconds: number, onExpire?: () => void): CountdownResult => {\n  15 |   const [remaining, setRemaining] = useState(totalSeconds);\n> 16 |   const deadlineRef = useRef<number>(Date.now() + totalSeconds * 1000);\n     |                                      ^^^^^^^^^^ Cannot call impure function\n  17 |   const onExpireRef = useRef(onExpire);\n  18 |\n  19 |   useEffect(() => {","import/order","`@/mocks/flag` import should occur before import of `@/shared/ui`","ImportDeclaration",{"range":"1002","text":"1003"},"no-console","Unexpected console statement.","MemberExpression","unexpected",["1004"],"prettier/prettier","Replace `·id:·1,·name:·'Админ',·lastName:·'Главный',·email:·'qwe.edfffff@school.local',·password:·'PjhNSSVhplOyvm6',·role:·'ADMIN',·className:·null` with `⏎····id:·1,⏎····name:·'Админ',⏎····lastName:·'Главный',⏎····email:·'qwe.edfffff@school.local',⏎····password:·'PjhNSSVhplOyvm6',⏎····role:·'ADMIN',⏎····className:·null,⏎·`","replace",{"range":"1005","text":"1006"},"Replace `·id:·2,·name:·'Мария',·lastName:·'Иванова',·email:·'teacher1@school.local',·password:·'teacher123',·role:·'TEACHER',·className:·null` with `⏎····id:·2,⏎····name:·'Мария',⏎····lastName:·'Иванова',⏎····email:·'teacher1@school.local',⏎····password:·'teacher123',⏎····role:·'TEACHER',⏎····className:·null,⏎·`",{"range":"1007","text":"1008"},"Replace `·id:·3,·name:·'Пётр',·lastName:·'Смирнов',·email:·'teacher2@school.local',·password:·'teacher123',·role:·'TEACHER',·className:·null` with `⏎····id:·3,⏎····name:·'Пётр',⏎····lastName:·'Смирнов',⏎····email:·'teacher2@school.local',⏎····password:·'teacher123',⏎····role:·'TEACHER',⏎····className:·null,⏎·`",{"range":"1009","text":"1010"},"Replace `·id:·4,·name:·'Анна',·lastName:·'Сидорова',·email:·'student1@school.local',·password:·'student123',·role:·'STUDENT',·className:·'9А'` with `⏎····id:·4,⏎····name:·'Анна',⏎····lastName:·'Сидорова',⏎····email:·'student1@school.local',⏎····password:·'student123',⏎····role:·'STUDENT',⏎····className:·'9А',⏎·`",{"range":"1011","text":"1012"},"Replace `·id:·5,·name:·'Иван',·lastName:·'Петров',·email:·'student2@school.local',·password:·'student123',·role:·'STUDENT',·className:·'9А'` with `⏎····id:·5,⏎····name:·'Иван',⏎····lastName:·'Петров',⏎····email:·'student2@school.local',⏎····password:·'student123',⏎····role:·