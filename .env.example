# Режим моков MSW.
# Значения:
#   - не задано (auto): health-check /api/auth/check; если сервер недоступен,
#     моки включаются автоматически. РАБОТАЕТ ТОЛЬКО В DEV (import.meta.env.DEV).
#     В production auto-режим отключён — при недоступном бэкенде отображается
#     обычный error-стейт, а не фейковые данные.
#   - true: моки всегда (обычно для локальной разработки без бэкенда).
#   - off: всегда реальный сервер.
VITE_USE_MOCKS=off

# Базовый URL API. По умолчанию '/api' идёт через Vite-proxy на бэкенд.
# VITE_API_URL=/api
